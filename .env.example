# =============================================================================
# soc-monitor - Configuración de entorno
# Copiar a .env y ajustar valores antes de iniciar en producción.
# =============================================================================

APP_NAME=soc-monitor
APP_ENV=production
DEBUG=false

# Servidor Web (HTTPS obligatorio en producción)
HOST=0.0.0.0
PORT=8443
SSL_CERTFILE=/etc/soc-monitor/certs/server.crt
SSL_KEYFILE=/etc/soc-monitor/certs/server.key

# Base de datos PostgreSQL 16
DATABASE_URL=postgresql+psycopg://socmonitor:CHANGE_ME_STRONG_PASSWORD@localhost:5432/socmonitor

# Seguridad y Cifrado
# Generar Fernet key con: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=CHANGE_ME_GENERATE_WITH_FERNET_KEY
# Secreto para firmar JWT de sesiones web (mínimo 32 caracteres aleatorios)
JWT_SECRET=CHANGE_ME_RANDOM_HEX_64_CHARS
SESSION_EXPIRE_MINUTES=480

# HashiCorp Vault (opcional)
VAULT_ENABLED=false
VAULT_ADDR=https://127.0.0.1:8200
VAULT_TOKEN=
VAULT_MOUNT_POINT=secret

# Escaneo y Concurrencia
SCAN_CRON_HOUR=2
SCAN_CRON_MINUTE=0
SCAN_MAX_WORKERS=25
HOST_TIMEOUT_SECONDS=45
HOST_MAX_RETRIES=2
WINRM_VERIFY_SSL=true

# Directorios
REPORTS_DIR=/var/lib/soc-monitor/reports
LOGS_DIR=/var/log/soc-monitor
LOG_LEVEL=INFO

# Bootstrap de usuario administrador inicial (solo si no existen usuarios en BD)
INITIAL_ADMIN_USER=socadmin
INITIAL_ADMIN_PASSWORD=CHANGE_ME_INITIAL_ADMIN_PASS
